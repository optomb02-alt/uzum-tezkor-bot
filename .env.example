# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Admin Telegram Chat ID (where registration notifications are delivered)
ADMIN_CHAT_ID=123456789

# PostgreSQL Database Connection String (e.g. from Neon or Supabase)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Vercel Cron Job authorization secret
CRON_SECRET=your_random_secret_string_here

# (Optional) Google Sheets Webhook URL (Google Apps Script web app)
SHEETS_WEBHOOK_URL=

# Training time (format HH:MM in Asia/Tashkent time)
TRAINING_TIME=10:00
